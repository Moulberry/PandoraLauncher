[package]
name = "zcheapstr"
version = "1.1.0"
authors = ["Zeeshan Ali Khan <zeeshanak@gnome.org>"]
edition = "2024"
rust-version = "1.87"

description = "An immutable, cheaply cloneable string type with borrowed, static and shared variants"
repository = "https://github.com/z-galaxy/zcheapstr/"
keywords = ["string", "cow", "zero-copy", "str", "borrowed"]
license = "MIT"
categories = ["data-structures", "memory-management", "no-std", "text-processing"]
readme = "README.md"

[features]
default = []
serde = ["dep:serde"]

[dependencies]
serde = { version = "1.0", default-features = false, features = ["derive"], optional = true }

[dev-dependencies]
serde_json = "1.0"

[package.metadata.docs.rs]
all-features = true
